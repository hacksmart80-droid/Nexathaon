*.egg

# Virtual Environment
venv/
env/
ENV/
env.bak/
venv.bak/

# Ephemeral session cases (preserve empty folder structure with .gitkeep)
temp/cases/*
!temp/cases/.gitkeep

# IDEs & Editor configs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Agent & AI tool cache
.agent/
